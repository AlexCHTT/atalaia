# Copie para .env só se precisar mudar algo. Para uma instalação normal NÃO é preciso configurar nada:
# suba o container, abra o painel no navegador e siga o assistente (o código dele aparece em: docker compose logs atalaia).

# --- Rede (o instalador install.sh / install.ps1 preenche) ---
# Porta aberta na rede e endereço de escuta (0.0.0.0 = toda a rede interna; 127.0.0.1 = só este servidor)
HTTP_PORT=8080
BIND_ADDRESS=0.0.0.0

# --- Instalação automatizada (opcional; sem isto o assistente de primeira execução faz o trabalho) ---
# Token dos agentes. Vazio = o servidor gera um e mostra na tela Instalação. Gere um com:  openssl rand -hex 32
ENROLL_TOKEN=
# Cria o primeiro administrador sem passar pelo assistente. Mínimo de 10 caracteres e sem o nome de usuário dentro.
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Valores iniciais (opcionais) ---
# Tudo abaixo pode ficar vazio: vale o padrão do sistema. Depois de instalado, ajuste esses e muitos outros parâmetros na tela
# Configurações do painel (retenção de dados, tempo de offline, segurança...), sem reiniciar. O que for definido lá tem prioridade.
OFFLINE_AFTER_MINUTES=
# IP do Nginx Proxy Manager (ex.: 192.168.1.10 ou 192.168.1.0/24). Vazio = não confia em X-Forwarded-For. Só mudável aqui (não na tela)
TRUSTED_PROXIES=
# Dias guardados das métricas de CPU/RAM/disco (padrão 30)
METRICS_RETENTION_DAYS=
# Auditoria dos dispositivos: vazio/0 = guarda para sempre. Defina em dias (ex.: 730 = 2 anos) para apagar o mais antigo automaticamente
EVENTS_RETENTION_DAYS=
# Teste de velocidade "até a internet" (usa speed.cloudflare.com): false desliga; vazio = ligado
SPEEDTEST_INTERNET=
